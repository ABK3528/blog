---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="404 - 页面走丢了" description="404 Not Found">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-16 relative w-full text-center">
            <div class="text-6xl font-bold text-[var(--primary)]">404</div>
            <div class="mt-5 text-90">这个页面不存在，或者已经被搬走了。</div>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href="/" class="btn-regular rounded-lg h-10 px-5 flex items-center">回首页</a>
                <a href="/archive/" class="btn-regular rounded-lg h-10 px-5 flex items-center">看归档</a>
            </div>
        </div>
    </div>
</MainGridLayout>
