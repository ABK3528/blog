---
// Cloudflare Web Analytics beacon — manual setup on purpose.
//
// Why not the dashboard's "automatic setup": it works by rewriting the HTML that comes back
// from an origin server, and this blog is served by a Worker (static assets), so the
// injection never fires. Verified: zone-level Web Analytics was already enabled with
// auto_install=true, yet no beacon appeared in the served HTML.
//
// `spa: true` is required because Fuwari navigates with Swup (client-side page swaps):
// without it, only the first page load of a session would be counted.
import { analyticsConfig } from "@/config";

const { enable, token } = analyticsConfig.cloudflareWebAnalytics;
---

{enable && token && (
	<script
		is:inline
		defer
		src="https://static.cloudflareinsights.com/beacon.min.js"
		data-cf-beacon={JSON.stringify({ token, spa: true })}
	></script>
)}
