{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fuwari-blog",
	"compatibility_date": "2026-09-30",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "blog.yjfkk.eu.org",
			"custom_domain": true
		},
		{
			"pattern": "preview.yjfkk.eu.org",
			"custom_domain": true
		}
	]
}